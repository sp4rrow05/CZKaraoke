# Copy this file to .env and fill in your own values. Never put real keys in this file:
# .env.example is committed to Git, .env is not.

# Get a key at https://console.cloud.google.com/apis/credentials (enable "YouTube Data API v3")
YOUTUBE_API_KEY=
PORT=3001

# Only needed when the pages are hosted on a different site (e.g. Vercel):
# comma-separated list of allowed page origins, "*" as a wildcard.
# CLIENT_ORIGIN=https://czkaraoke.vercel.app
# Set to 1 behind a hosting proxy such as Render, so rate limits see real visitor IPs.
# TRUST_PROXY=1
